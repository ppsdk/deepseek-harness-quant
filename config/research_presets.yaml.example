strategies:
  jq_ma5_filter:
    name: 聚宽教程改编：高于5日均线1%
    desc: 换股日筛选收盘高于5日均线至少1%的股票。简化了原教程在0至1%区间保持原仓的逻辑。
    category: 平台教程改编
    source_id: joinquant
    instant: true
    factor_list:
    - name: bias_5
      sign: 1
      min: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  jq_positive_low_pe:
    name: 聚宽财务教程改编：正市盈率不超过10
    desc: 只采用官方例子中的低PE条件，并排除负值；未采用原市值和营收门槛。需要历史PE记录。
    category: 平台教程改编
    source_id: joinquant
    instant: true
    factor_list:
    - name: fund_pe_ttm
      sign: -1
      min: 0.01
      max: 10
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 60
  ma_trend:
    name: 均线趋势：20 日不低于 60 日
    desc: 只选 20 日均线不低于 60 日均线的股票，再优先比较 60 日涨幅。
    category: 技术指标策略
    instant: true
    factor_list:
    - name: ma_trend
      sign: 1
      min: 0
    - name: roc_60
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 20
  ma_golden:
    name: 均线金叉：5 日上穿 20 日
    desc: 只选当天 5 日均线刚上穿 20 日均线的股票，再比较近期涨幅。
    category: 技术指标策略
    instant: true
    factor_list:
    - name: ma_cross
      sign: 1
      min: 1
    - name: roc_20
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  macd_golden:
    name: MACD 当天金叉
    desc: 只选 DIF 当天从下向上穿过 DEA 的股票，再比较 MACD 柱的大小。
    category: 技术指标策略
    instant: true
    factor_list:
    - name: macd_cross
      sign: 1
      min: 1
    - name: macd_hist
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  rsi_oversold:
    name: RSI 低于 30：寻找超卖
    desc: 只选 RSI 14 不超过 30 的股票，RSI 越低越优先；不代表一定反弹。
    category: 技术指标策略
    instant: true
    factor_list:
    - name: rsi_14
      sign: -1
      max: 30
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  boll_lower:
    name: 靠近或跌破布林带下轨
    desc: 只选布林带位置不超过 10% 的股票，位置越低越优先。
    category: 技术指标策略
    instant: true
    factor_list:
    - name: boll_position
      sign: -1
      max: 10
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  volume_breakout:
    name: 放量突破此前 20 日高点
    desc: 收盘达到或超过此前 20 日最高价，且 5 日均量至少为 20 日均量的 1.2 倍。
    category: 技术指标策略
    instant: true
    factor_list:
    - name: breakout_20
      sign: 1
      min: 0
    - name: volume_ratio
      sign: 1
      min: 1.2
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  momentum60:
    name: 近三个月涨幅较大
    desc: 按 60 个交易日涨幅排序，涨幅较大者优先。
    category: 技术指标策略
    instant: true
    factor_list:
    - name: roc_60
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 20
  stable_atr:
    name: 价格波动较小
    desc: 按 ATR 占股价比例和近 20 日波动排序，两项都较小者优先。
    category: 技术指标策略
    instant: true
    factor_list:
    - name: atr_14
      sign: -1
    - name: volatility_20
      sign: -1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 20
  alpha101_12:
    name: Alpha101 第 12 号：量价变化
    desc: 使用论文第 12 号公式，比较成交量变化方向与当天价格变化。
    category: Alpha101 示例
    instant: true
    factor_list:
    - name: alpha101_012
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  alpha101_101:
    name: Alpha101 第 101 号：收盘表现
    desc: 使用当天收盘相对开盘的变化，除以当天高低价差；下一交易日才成交。
    category: Alpha101 示例
    instant: true
    factor_list:
    - name: alpha101_101
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  quality:
    name: 盈利能力与经营现金流
    desc: ROE 与每股经营现金流都大于等于 0，再优先比较 ROE 与毛利率。
    category: 基本面选股
    instant: true
    factor_list:
    - name: fund_roe
      sign: 1
      min: 0
    - name: fund_cashflow_ps
      sign: 1
      min: 0
    - name: fund_gross_margin
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 60
  growth:
    name: 收入和利润共同增长
    desc: 收入和利润同比增长都至少为 10%，再按两项增长率综合排名。
    category: 基本面选股
    instant: true
    factor_list:
    - name: fund_revenue_growth
      sign: 1
      min: 10
    - name: fund_profit_growth
      sign: 1
      min: 10
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 60
  value:
    name: 低估值：正市盈率与正市净率
    desc: 只选 PE、PB 都大于 0 的股票，两个值越低越优先；需要历史估值记录。
    category: 基本面选股
    instant: true
    factor_list:
    - name: fund_pe_ttm
      sign: -1
      min: 0.01
    - name: fund_pb
      sign: -1
      min: 0.01
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 60
  dividend:
    name: 股息率较高
    desc: 在过去一年股息率大于 0 的股票中优先选择股息率较高者；需要历史分红数据。
    category: 基本面选股
    instant: true
    factor_list:
    - name: fund_dividend_yield
      sign: 1
      min: 0.01
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 60
  quality_debt:
    name: 盈利较好、负债较低
    desc: ROE 至少 10%，资产负债率不高于 60%，再比较盈利与负债水平；需另导入负债率。
    category: 基本面选股
    instant: true
    factor_list:
    - name: fund_roe
      sign: 1
      min: 10
    - name: fund_debt_ratio
      sign: -1
      max: 60
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 60
  ema_trend:
    name: EMA趋势：20期高于60期
    desc: 用自定义均线差判断上升趋势，再优先近期涨幅。
    category: 技术指标策略
    instant: true
    factor_list:
    - name: ema_trend_gap
      sign: 1
      min: 0
    - name: roc_60
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 20
  cmo_rebound:
    name: CMO超卖观察
    desc: 选择CMO不高于-40的股票，低值优先；不是触底保证。
    category: 技术指标策略
    instant: true
    factor_list:
    - name: cmo_14
      sign: -1
      max: -40
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 20
  aroon_trend:
    name: Aroon趋势：近期有新高、少见新低
    desc: 选择Aroon上涨线至少80且下跌线不超过30的股票。
    category: 技术指标策略
    instant: true
    factor_list:
    - name: aroon_up_25
      sign: 1
      min: 80
    - name: aroon_down_25
      sign: -1
      max: 30
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 20
  trix_positive:
    name: TRIX向上
    desc: 选择三重指数均线变化率非负的股票，变化较大者优先。
    category: 技术指标策略
    instant: true
    factor_list:
    - name: trix_15
      sign: 1
      min: 0
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 20
  stoch_rsi_rebound:
    name: 随机RSI低位观察
    desc: 选择随机RSI不超过20的股票，低值优先；只在换股日检查。
    category: 技术指标策略
    instant: true
    factor_list:
