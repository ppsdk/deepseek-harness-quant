      stocks: 100
      rebalance_days: 20
  turn_stable:
    name: 聚宽文章改编：换手波动较小
    desc: 按60日换手率标准差排序，低值优先；不使用整年缩尾或未来行业分类。
    category: 技术指标策略
    instant: true
    factor_list:
