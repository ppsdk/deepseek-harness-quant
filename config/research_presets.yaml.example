strategies:
  jq_ma5_filter:
    name: 聚宽教程改编：高于5日均线1%
    desc: 换股日筛选收盘高于5日均线至少1%的股票。简化了原教程在0至1%区间保持原仓的逻辑。
    category: 技术指标
    source_id: joinquant
    instant: true
    factor_list:
    - name: bias_5
      sign: 1
      min: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  jq_positive_low_pe:
    name: 聚宽财务教程改编：正市盈率不超过10
    desc: 只采用官方例子中的低PE条件，并排除负值；未采用原市值和营收门槛。需要历史PE记录。
    category: 基本面
    source_id: joinquant
    instant: true
    factor_list:
    - name: fund_pe_ttm
      sign: -1
      min: 0.01
      max: 10
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 60
  ma_trend:
    name: 均线趋势：20 日不低于 60 日
    desc: 只选 20 日均线不低于 60 日均线的股票，再优先比较 60 日涨幅。
    category: 技术指标
    instant: true
    factor_list:
    - name: ma_trend
      sign: 1
      min: 0
    - name: roc_60
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 20
  ma_golden:
    name: 均线金叉：5 日上穿 20 日
    desc: 只选当天 5 日均线刚上穿 20 日均线的股票，再比较近期涨幅。
    category: 技术指标
    instant: true
    factor_list:
    - name: ma_cross
      sign: 1
      min: 1
    - name: roc_20
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  macd_golden:
    name: MACD 当天金叉
    desc: 只选 DIF 当天从下向上穿过 DEA 的股票，再比较 MACD 柱的大小。
    category: 技术指标
    instant: true
    factor_list:
    - name: macd_cross
      sign: 1
      min: 1
    - name: macd_hist
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  rsi_oversold:
    name: RSI 低于 30：寻找超卖
    desc: 只选 RSI 14 不超过 30 的股票，RSI 越低越优先；不代表一定反弹。
    category: 技术指标
    instant: true
    factor_list:
    - name: rsi_14
      sign: -1
      max: 30
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  boll_lower:
    name: 靠近或跌破布林带下轨
    desc: 只选布林带位置不超过 10% 的股票，位置越低越优先。
    category: 技术指标
    instant: true
    factor_list:
    - name: boll_position
      sign: -1
      max: 10
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  volume_breakout:
    name: 放量突破此前 20 日高点
    desc: 收盘达到或超过此前 20 日最高价，且 5 日均量至少为 20 日均量的 1.2 倍。
    category: 技术指标
    instant: true
    factor_list:
    - name: breakout_20
      sign: 1
      min: 0
    - name: volume_ratio
      sign: 1
      min: 1.2
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  momentum60:
    name: 近三个月涨幅较大
    desc: 按 60 个交易日涨幅排序，涨幅较大者优先。
    category: 动量
    instant: true
    factor_list:
    - name: roc_60
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 20
  stable_atr:
    name: 价格波动较小
    desc: 按 ATR 占股价比例和近 20 日波动排序，两项都较小者优先。
    category: 技术指标
    instant: true
    factor_list:
    - name: atr_14
      sign: -1
    - name: volatility_20
      sign: -1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 20
  alpha101_12:
    name: Alpha101 第 12 号：量价变化
    desc: 使用论文第 12 号公式，比较成交量变化方向与当天价格变化。
    category: 因子与Alpha
    instant: true
    factor_list:
    - name: alpha101_012
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  alpha101_101:
    name: Alpha101 第 101 号：收盘表现
    desc: 使用当天收盘相对开盘的变化，除以当天高低价差；下一交易日才成交。
    category: 因子与Alpha
    instant: true
    factor_list:
    - name: alpha101_101
      sign: 1
    defaults:
      topn: 10
      stocks: 100
      rebalance_days: 5
  quality:
    name: 盈利能力与经营现金流
    desc: ROE 与每股经营现金流都大于等于 0，再优先比较 ROE 与毛利率。
    category: 基本面
    instant: true
    factor_list:
