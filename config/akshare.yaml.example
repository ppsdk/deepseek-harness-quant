# AKShare A-share download settings. Actual data remains in the ignored cache.
universe: all_a            # all_a / csi300 / explicit
codes: []                  # explicit: ["600519.SH", "000001.SZ"]
start: "2019-01-01"
end: null                  # null = today in Asia/Shanghai, excluding unfinished daily bars
adjust: qfq                # qfq / hfq / none
limit: 20                  # 0 = complete selected universe; evenly spaced sample otherwise
backends: [eastmoney, sina, tencent]
request_timeout: 15
retries: 1
pause_seconds: 1.5
minimum_rows: 60
backend_failure_threshold: 3   # consecutive failures before temporarily skipping an endpoint
backend_cooldown_seconds: 120
resume: true               # only reuses verified entries for exactly the same request window
refresh: false             # true = re-fetch the entire requested adjustment window
