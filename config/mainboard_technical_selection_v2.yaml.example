    operation: ma_trend
    mode: event
    execution:
      trade_mode: event
      rebalance_days: 20
      min_trade_interval_days: 5
      stop_loss_pct: 5
      take_profit_pct: 20
      trailing_stop_pct: 0
      risk_cooldown_days: 10
    score_factors:
    - lowvol_60
    - turn_20d
  dual_momentum_defensive:
    average: sma
    fast: 20
    slow: 60
    confirm_days: 2
    momentum_periods:
    - 63
    - 126
    absolute_period: 63
    skip_days: 0
    score: defensive
    risk_pool: balanced
