    operation: dual_momentum
    mode: fixed
    execution:
      trade_mode: fixed
      rebalance_days: 20
      min_trade_interval_days: 5
      stop_loss_pct: 5
      take_profit_pct: 20
      trailing_stop_pct: 0
      risk_cooldown_days: 10
  ma20_60:
    average: sma
    fast: 20
    slow: 60
    confirm_days: 2
    momentum_periods:
    - 63
    - 126
    absolute_period: 63
    skip_days: 0
    score: momentum
    risk_pool: balanced
    label: MA20/60趋势＋止损止盈
    operation: ma_trend
    mode: event
    execution:
      trade_mode: event
      rebalance_days: 20
      min_trade_interval_days: 5
      stop_loss_pct: 5
      take_profit_pct: 20
      trailing_stop_pct: 0
      risk_cooldown_days: 10
  ma20_120:
    average: sma
    fast: 20
    slow: 120
    confirm_days: 2
    momentum_periods:
    - 63
    - 126
    absolute_period: 63
    skip_days: 0
    score: momentum
    risk_pool: balanced
    label: MA20/120长趋势＋止损止盈
    operation: ma_trend
    mode: event
    execution:
      trade_mode: event
      rebalance_days: 20
      min_trade_interval_days: 5
      stop_loss_pct: 5
      take_profit_pct: 20
      trailing_stop_pct: 0
      risk_cooldown_days: 10
  ema20_60_trailing:
    average: ema
    fast: 20
    slow: 60
    confirm_days: 2
    momentum_periods:
    - 63
    - 126
    absolute_period: 63
    skip_days: 0
    score: momentum
    risk_pool: balanced
