base_config: mainboard_repair_v3
output_dir: output/strategy_research/mainboard_technical_overall_v1
acceptance:
  max_annual_one_way_turnover: 3.0
  min_average_exposure: 0.08
  min_trade_dates: 4
execution:
  topn: 5
  max_traded_codes_per_day: 5
  max_position_pct: 20
  selection_policy: stable_diverse
variants:
- id: exposure60
  target_exposure_pct: 60
- id: exposure80
  target_exposure_pct: 80
candidates:
  dual_momentum:
    average: sma
    fast: 20
    slow: 60
    confirm_days: 2
    momentum_periods:
    - 63
    - 126
    absolute_period: 63
    skip_days: 0
    score: momentum
    risk_pool: balanced
    label: 双期限截面动量＋绝对动量过滤
    operation: dual_momentum
    mode: fixed
    execution:
      trade_mode: fixed
      rebalance_days: 20
      min_trade_interval_days: 5
      stop_loss_pct: 5
      take_profit_pct: 20
      trailing_stop_pct: 0
      risk_cooldown_days: 10
  dual_momentum_skip:
    average: sma
    fast: 20
    slow: 60
    confirm_days: 2
    momentum_periods:
    - 63
    - 126
    absolute_period: 63
    skip_days: 21
    score: momentum
    risk_pool: balanced
    label: 双期限截面动量跳过近21日
    operation: dual_momentum
    mode: fixed
    execution:
      trade_mode: fixed
      rebalance_days: 20
      min_trade_interval_days: 5
      stop_loss_pct: 5
      take_profit_pct: 20
      trailing_stop_pct: 0
      risk_cooldown_days: 10
  ma20_60:
    average: sma
    fast: 20
    slow: 60
    confirm_days: 2
    momentum_periods:
    - 63
    - 126
    absolute_period: 63
    skip_days: 0
    score: momentum
    risk_pool: balanced
    label: MA20/60趋势＋止损止盈
    operation: ma_trend
    mode: event
    execution:
      trade_mode: event
      rebalance_days: 20
      min_trade_interval_days: 5
      stop_loss_pct: 5
      take_profit_pct: 20
      trailing_stop_pct: 0
      risk_cooldown_days: 10
  ma20_120:
    average: sma
    fast: 20
    slow: 120
    confirm_days: 2
    momentum_periods:
    - 63
    - 126
    absolute_period: 63
    skip_days: 0
    score: momentum
    risk_pool: balanced
    label: MA20/120长趋势＋止损止盈
    operation: ma_trend
    mode: event
    execution:
      trade_mode: event
      rebalance_days: 20
      min_trade_interval_days: 5
      stop_loss_pct: 5
      take_profit_pct: 20
      trailing_stop_pct: 0
      risk_cooldown_days: 10
  ema20_60_trailing:
    average: ema
    fast: 20
    slow: 60
    confirm_days: 2
    momentum_periods:
    - 63
    - 126
    absolute_period: 63
    skip_days: 0
    score: momentum
    risk_pool: balanced
