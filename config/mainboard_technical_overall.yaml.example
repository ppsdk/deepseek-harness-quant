    operation: ma_trend
    mode: event
    execution:
      trade_mode: event
      rebalance_days: 20
      min_trade_interval_days: 5
      stop_loss_pct: 5
      take_profit_pct: 0
      trailing_stop_pct: 8
      risk_cooldown_days: 10
  ma60_pullback:
    average: sma
    fast: 20
    slow: 60
    confirm_days: 2
    momentum_periods:
    - 63
    - 126
    absolute_period: 63
    skip_days: 0
    score: defensive
    risk_pool: balanced
    min_price_vs_slow: -0.01
    max_price_vs_slow: 0.05
    slope_days: 10
    min_slope: 0.0
    score_factors:
    - lowvol_60
    - turn_20d
