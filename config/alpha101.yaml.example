    - raw_close
    - volume
    - vwap
    default_sign: 1
  alpha101_082:
    label: Alpha101 第 82 号
    description: 用开盘价、成交量计算选股分数。还需要当时的行业分类。
    category: Alpha101
    kind: alpha101
    formula: (min(rank(decay_linear(delta(open, 1.46063), 14.8717)), Ts_Rank(decay_linear(correlation(IndNeutralize(volume,
      IndClass.sector), ((open * 0.634196) + (open * (1 - 0.634196))), 17.4842), 6.92131), 13.4283)) * -1)
