    kind: alpha101
    formula: ((rank(Sign(delta(IndNeutralize(((open * 0.868128) + (high * (1 - 0.868128))), IndClass.industry),
      4.04545)))^Ts_Rank(correlation(high, adv10, 5.11456), 5.53756)) * -1)
