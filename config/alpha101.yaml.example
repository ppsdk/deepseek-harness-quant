    category: Alpha101
    kind: alpha101
    formula: min(rank(decay_linear(((((high + low) / 2) + high) - (vwap + high)), 20.0451)), rank(decay_linear(correlation(((high
      + low) / 2), adv40, 3.1614), 5.64125)))
    requires:
    - amount
    - high
    - low
    - raw_close
    - vwap
    default_sign: 1
  alpha101_078:
    label: Alpha101 第 78 号
    description: 用最低价、成交量、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (rank(correlation(sum(((low * 0.352233) + (vwap * (1 - 0.352233))), 19.7428), sum(adv40, 19.7428),
      6.83313))^rank(correlation(rank(vwap), rank(volume), 5.77492)))
