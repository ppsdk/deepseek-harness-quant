source:
  title: 101 Formulaic Alphas
  url: https://arxiv.org/abs/1601.00991
  pdf_sha256: 1f9c21afe32dcb3ee77b31548acdaea00451fbfa1c0ee10c907867bcc736fce9
  notes:
  - 公式来自原论文附录 A；小数天数向下取整。
  - 日均成交额 adv 按原论文的 dollar volume 定义，使用成交额，不替换成成交量。
  - 排名采用平均名次后除以有效股票数；时间序列排名同样归一到 0 到 1。
  - SignedPower 使用 sign(x) * abs(x)^a；^ 使用普通幂。
  - 四个原论文当日收盘交易的信号（42、48、53、54）在本框架仍统一下一交易日开盘交易。
  - 仅实现公开公式，不代表复现原论文收益或已经适合 A 股。
factors:
  alpha101_001:
    label: Alpha101 第 1 号：比较下跌波动和价格高点
    description: 用收盘价、每天涨跌幅计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: '(rank(Ts_ArgMax(SignedPower(((returns < 0) ? stddev(returns, 20) : close), 2.), 5)) - 0.5)'
    requires:
    - close
    default_sign: 1
  alpha101_002:
    label: Alpha101 第 2 号：比较成交量变化与当天涨幅
    description: 用开盘价、收盘价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * correlation(rank(delta(log(volume), 2)), rank(((close - open) / open)), 6))
    requires:
    - close
    - open
    - volume
    default_sign: 1
  alpha101_003:
    label: Alpha101 第 3 号：比较开盘价与成交量变化
    description: 用开盘价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * correlation(rank(open), rank(volume), 10))
    requires:
    - open
    - volume
    default_sign: 1
  alpha101_004:
    label: Alpha101 第 4 号：观察近期最低价的位置
    description: 用最低价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * Ts_Rank(rank(low), 9))
    requires:
    - low
    default_sign: 1
  alpha101_005:
    label: Alpha101 第 5 号
    description: 用开盘价、收盘价、成交均价计算选股分数。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (rank((open - (sum(vwap, 10) / 10))) * (-1 * abs(rank((close - vwap)))))
    requires:
    - close
    - open
    - raw_close
    - vwap
    default_sign: 1
  alpha101_006:
    label: Alpha101 第 6 号：比较价格和成交量是否同步
    description: 用开盘价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * correlation(open, volume, 10))
    requires:
    - open
    - volume
    default_sign: 1
  alpha101_007:
    label: Alpha101 第 7 号
    description: 用收盘价、成交量计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。
    category: Alpha101
    kind: alpha101
    formula: '((adv20 < volume) ? ((-1 * ts_rank(abs(delta(close, 7)), 60)) * sign(delta(close, 7))) : (-1 * 1))'
    requires:
    - amount
    - close
    - volume
    default_sign: 1
  alpha101_008:
    label: Alpha101 第 8 号
    description: 用开盘价、每天涨跌幅计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * rank(((sum(open, 5) * sum(returns, 5)) - delay((sum(open, 5) * sum(returns, 5)), 10))))
    requires:
    - close
    - open
    default_sign: 1
  alpha101_009:
    label: Alpha101 第 9 号
    description: 用收盘价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: '((0 < ts_min(delta(close, 1), 5)) ? delta(close, 1) : ((ts_max(delta(close, 1), 5) < 0) ? delta(close,
      1) : (-1 * delta(close, 1))))'
    requires:
    - close
    default_sign: 1
  alpha101_010:
    label: Alpha101 第 10 号
    description: 用收盘价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: 'rank(((0 < ts_min(delta(close, 1), 4)) ? delta(close, 1) : ((ts_max(delta(close, 1), 4) < 0) ? delta(close,
      1) : (-1 * delta(close, 1)))))'
    requires:
    - close
    default_sign: 1
  alpha101_011:
    label: Alpha101 第 11 号
    description: 用收盘价、成交量、成交均价计算选股分数。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: ((rank(ts_max((vwap - close), 3)) + rank(ts_min((vwap - close), 3))) * rank(delta(volume, 3)))
    requires:
    - close
    - raw_close
    - volume
    - vwap
    default_sign: 1
  alpha101_012:
    label: Alpha101 第 12 号：成交量变化与价格涨跌
    description: 用收盘价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (sign(delta(volume, 1)) * (-1 * delta(close, 1)))
    requires:
    - close
    - volume
    default_sign: 1
  alpha101_013:
    label: Alpha101 第 13 号
    description: 用收盘价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * rank(covariance(rank(close), rank(volume), 5)))
    requires:
    - close
    - volume
    default_sign: 1
  alpha101_014:
    label: Alpha101 第 14 号
    description: 用开盘价、成交量、每天涨跌幅计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: ((-1 * rank(delta(returns, 3))) * correlation(open, volume, 10))
    requires:
    - close
    - open
    - volume
    default_sign: 1
  alpha101_015:
    label: Alpha101 第 15 号
    description: 用最高价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * sum(rank(correlation(rank(high), rank(volume), 3)), 3))
    requires:
    - high
    - volume
    default_sign: 1
  alpha101_016:
    label: Alpha101 第 16 号
    description: 用最高价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * rank(covariance(rank(high), rank(volume), 5)))
    requires:
    - high
    - volume
    default_sign: 1
  alpha101_017:
    label: Alpha101 第 17 号
    description: 用收盘价、成交量计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。
    category: Alpha101
    kind: alpha101
    formula: (((-1 * rank(ts_rank(close, 10))) * rank(delta(delta(close, 1), 1))) * rank(ts_rank((volume / adv20),
      5)))
    requires:
    - amount
    - close
    - volume
    default_sign: 1
  alpha101_018:
    label: Alpha101 第 18 号
    description: 用开盘价、收盘价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * rank(((stddev(abs((close - open)), 5) + (close - open)) + correlation(close, open, 10))))
    requires:
    - close
    - open
    default_sign: 1
  alpha101_019:
    label: Alpha101 第 19 号
    description: 用收盘价、每天涨跌幅计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: ((-1 * sign(((close - delay(close, 7)) + delta(close, 7)))) * (1 + rank((1 + sum(returns, 250)))))
    requires:
    - close
    default_sign: 1
  alpha101_020:
    label: Alpha101 第 20 号
    description: 用开盘价、收盘价、最高价、最低价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (((-1 * rank((open - delay(high, 1)))) * rank((open - delay(close, 1)))) * rank((open - delay(low,
      1))))
    requires:
    - close
    - high
    - low
    - open
    default_sign: 1
  alpha101_021:
    label: Alpha101 第 21 号
    description: 用收盘价、成交量计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。
    category: Alpha101
    kind: alpha101
    formula: '((((sum(close, 8) / 8) + stddev(close, 8)) < (sum(close, 2) / 2)) ? (-1 * 1) : (((sum(close, 2) /
      2) < ((sum(close, 8) / 8) - stddev(close, 8))) ? 1 : (((1 < (volume / adv20)) || ((volume / adv20) == 1))
      ? 1 : (-1 * 1))))'
    requires:
    - amount
    - close
    - volume
    default_sign: 1
  alpha101_022:
    label: Alpha101 第 22 号
    description: 用收盘价、最高价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * (delta(correlation(high, volume, 5), 5) * rank(stddev(close, 20))))
    requires:
    - close
    - high
    - volume
    default_sign: 1
  alpha101_023:
    label: Alpha101 第 23 号
    description: 用最高价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: '(((sum(high, 20) / 20) < high) ? (-1 * delta(high, 2)) : 0)'
    requires:
    - high
    default_sign: 1
  alpha101_024:
    label: Alpha101 第 24 号
    description: 用收盘价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: '((((delta((sum(close, 100) / 100), 100) / delay(close, 100)) < 0.05) || ((delta((sum(close, 100) /
      100), 100) / delay(close, 100)) == 0.05)) ? (-1 * (close - ts_min(close, 100))) : (-1 * delta(close, 3)))'
    requires:
    - close
    default_sign: 1
  alpha101_025:
    label: Alpha101 第 25 号
    description: 用收盘价、最高价、每天涨跌幅、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: rank(((((-1 * returns) * adv20) * vwap) * (high - close)))
    requires:
    - amount
    - close
    - high
    - raw_close
    - vwap
    default_sign: 1
  alpha101_026:
    label: Alpha101 第 26 号
    description: 用最高价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * ts_max(correlation(ts_rank(volume, 5), ts_rank(high, 5), 5), 3))
    requires:
    - high
    - volume
    default_sign: 1
  alpha101_027:
    label: Alpha101 第 27 号
    description: 用成交量、成交均价计算选股分数。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: '((0.5 < rank((sum(correlation(rank(volume), rank(vwap), 6), 2) / 2.0))) ? (-1 * 1) : 1)'
    requires:
    - raw_close
    - volume
    - vwap
    default_sign: 1
  alpha101_028:
    label: Alpha101 第 28 号
    description: 用收盘价、最高价、最低价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。
    category: Alpha101
    kind: alpha101
    formula: scale(((correlation(adv20, low, 5) + ((high + low) / 2)) - close))
    requires:
    - amount
    - close
    - high
    - low
    default_sign: 1
  alpha101_029:
    label: Alpha101 第 29 号
    description: 用收盘价、每天涨跌幅计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (min(product(rank(rank(scale(log(sum(ts_min(rank(rank((-1 * rank(delta((close - 1), 5))))), 2), 1))))),
      1), 5) + ts_rank(delay((-1 * returns), 6), 5))
    requires:
    - close
    default_sign: 1
  alpha101_030:
    label: Alpha101 第 30 号
    description: 用收盘价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (((1.0 - rank(((sign((close - delay(close, 1))) + sign((delay(close, 1) - delay(close, 2)))) + sign((delay(close,
      2) - delay(close, 3)))))) * sum(volume, 5)) / sum(volume, 20))
    requires:
    - close
    - volume
    default_sign: 1
  alpha101_031:
    label: Alpha101 第 31 号
    description: 用收盘价、最低价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。
    category: Alpha101
    kind: alpha101
    formula: ((rank(rank(rank(decay_linear((-1 * rank(rank(delta(close, 10)))), 10)))) + rank((-1 * delta(close,
      3)))) + sign(scale(correlation(adv20, low, 12))))
    requires:
    - amount
    - close
    - low
    default_sign: 1
  alpha101_032:
    label: Alpha101 第 32 号
    description: 用收盘价、成交均价计算选股分数。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (scale(((sum(close, 7) / 7) - close)) + (20 * scale(correlation(vwap, delay(close, 5), 230))))
    requires:
    - close
    - raw_close
    - vwap
    default_sign: 1
  alpha101_033:
    label: Alpha101 第 33 号：比较开盘价与收盘价
    description: 用开盘价、收盘价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: rank((-1 * ((1 - (open / close))^1)))
    requires:
    - close
    - open
    default_sign: 1
  alpha101_034:
    label: Alpha101 第 34 号
    description: 用收盘价、每天涨跌幅计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: rank(((1 - rank((stddev(returns, 2) / stddev(returns, 5)))) + (1 - rank(delta(close, 1)))))
    requires:
    - close
    default_sign: 1
  alpha101_035:
    label: Alpha101 第 35 号
    description: 用收盘价、最高价、最低价、成交量、每天涨跌幅计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: ((Ts_Rank(volume, 32) * (1 - Ts_Rank(((close + high) - low), 16))) * (1 - Ts_Rank(returns, 32)))
    requires:
    - close
    - high
    - low
    - volume
    default_sign: 1
  alpha101_036:
    label: Alpha101 第 36 号
    description: 用开盘价、收盘价、成交量、每天涨跌幅、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (((((2.21 * rank(correlation((close - open), delay(volume, 1), 15))) + (0.7 * rank((open - close))))
      + (0.73 * rank(Ts_Rank(delay((-1 * returns), 6), 5)))) + rank(abs(correlation(vwap, adv20, 6)))) + (0.6 *
      rank((((sum(close, 200) / 200) - open) * (close - open)))))
    requires:
    - amount
    - close
    - open
    - raw_close
    - volume
    - vwap
    default_sign: 1
  alpha101_037:
    label: Alpha101 第 37 号
    description: 用开盘价、收盘价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (rank(correlation(delay((open - close), 1), close, 200)) + rank((open - close)))
    requires:
    - close
    - open
    default_sign: 1
  alpha101_038:
    label: Alpha101 第 38 号：比较近期价格位置与当天涨幅
    description: 用开盘价、收盘价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: ((-1 * rank(Ts_Rank(close, 10))) * rank((close / open)))
    requires:
    - close
    - open
    default_sign: 1
  alpha101_039:
    label: Alpha101 第 39 号
    description: 用收盘价、成交量、每天涨跌幅计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。
    category: Alpha101
    kind: alpha101
    formula: ((-1 * rank((delta(close, 7) * (1 - rank(decay_linear((volume / adv20), 9)))))) * (1 + rank(sum(returns,
      250))))
    requires:
    - amount
    - close
    - volume
    default_sign: 1
  alpha101_040:
    label: Alpha101 第 40 号
    description: 用最高价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: ((-1 * rank(stddev(high, 10))) * correlation(high, volume, 10))
    requires:
    - high
    - volume
    default_sign: 1
  alpha101_041:
    label: Alpha101 第 41 号：比较日内价格中点和成交均价
    description: 用最高价、最低价、成交均价计算选股分数。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (((high * low)^0.5) - vwap)
    requires:
    - high
    - low
    - raw_close
    - vwap
    default_sign: 1
  alpha101_042:
    label: Alpha101 第 42 号：比较收盘价与成交均价
    description: 用收盘价、成交均价计算选股分数。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (rank((vwap - close)) / rank((vwap + close)))
    requires:
    - close
    - raw_close
    - vwap
    default_sign: 1
  alpha101_043:
    label: Alpha101 第 43 号
    description: 用收盘价、成交量计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。
    category: Alpha101
    kind: alpha101
    formula: (ts_rank((volume / adv20), 20) * ts_rank((-1 * delta(close, 7)), 8))
    requires:
    - amount
    - close
    - volume
    default_sign: 1
  alpha101_044:
    label: Alpha101 第 44 号
    description: 用最高价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * correlation(high, rank(volume), 5))
    requires:
    - high
    - volume
    default_sign: 1
  alpha101_045:
    label: Alpha101 第 45 号
    description: 用收盘价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * ((rank((sum(delay(close, 5), 20) / 20)) * correlation(close, volume, 2)) * rank(correlation(sum(close,
      5), sum(close, 20), 2))))
    requires:
    - close
    - volume
    default_sign: 1
  alpha101_046:
    label: Alpha101 第 46 号
    description: 用收盘价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: '((0.25 < (((delay(close, 20) - delay(close, 10)) / 10) - ((delay(close, 10) - close) / 10))) ? (-1
      * 1) : (((((delay(close, 20) - delay(close, 10)) / 10) - ((delay(close, 10) - close) / 10)) < 0) ? 1 : ((-1
      * 1) * (close - delay(close, 1)))))'
    requires:
    - close
    default_sign: 1
  alpha101_047:
    label: Alpha101 第 47 号
    description: 用收盘价、最高价、成交量、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: ((((rank((1 / close)) * volume) / adv20) * ((high * rank((high - close))) / (sum(high, 5) / 5))) -
      rank((vwap - delay(vwap, 5))))
    requires:
    - amount
    - close
    - high
    - raw_close
    - volume
    - vwap
    default_sign: 1
  alpha101_048:
    label: Alpha101 第 48 号
    description: 用收盘价计算选股分数。还需要当时的行业分类。
    category: Alpha101
    kind: alpha101
    formula: (indneutralize(((correlation(delta(close, 1), delta(delay(close, 1), 1), 250) * delta(close, 1)) /
      close), IndClass.subindustry) / sum(((delta(close, 1) / delay(close, 1))^2), 250))
    requires:
    - close
    - industry_history
    default_sign: 1
  alpha101_049:
    label: Alpha101 第 49 号
    description: 用收盘价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: '(((((delay(close, 20) - delay(close, 10)) / 10) - ((delay(close, 10) - close) / 10)) < (-1 * 0.1))
      ? 1 : ((-1 * 1) * (close - delay(close, 1))))'
    requires:
    - close
    default_sign: 1
  alpha101_050:
    label: Alpha101 第 50 号
    description: 用成交量、成交均价计算选股分数。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (-1 * ts_max(rank(correlation(rank(volume), rank(vwap), 5)), 5))
    requires:
    - raw_close
    - volume
    - vwap
    default_sign: 1
  alpha101_051:
    label: Alpha101 第 51 号
    description: 用收盘价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: '(((((delay(close, 20) - delay(close, 10)) / 10) - ((delay(close, 10) - close) / 10)) < (-1 * 0.05))
      ? 1 : ((-1 * 1) * (close - delay(close, 1))))'
    requires:
    - close
    default_sign: 1
  alpha101_052:
    label: Alpha101 第 52 号
    description: 用最低价、成交量、每天涨跌幅计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: ((((-1 * ts_min(low, 5)) + delay(ts_min(low, 5), 5)) * rank(((sum(returns, 240) - sum(returns, 20))
      / 220))) * ts_rank(volume, 5))
    requires:
    - close
    - low
    - volume
    default_sign: 1
  alpha101_053:
    label: Alpha101 第 53 号：观察收盘价在日内区间的位置变化
    description: 用收盘价、最高价、最低价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * delta((((close - low) - (high - close)) / (close - low)), 9))
    requires:
    - close
    - high
    - low
    default_sign: 1
  alpha101_054:
    label: Alpha101 第 54 号：比较开收盘价和日内振幅
    description: 用开盘价、收盘价、最高价、最低价计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: ((-1 * ((low - close) * (open^5))) / ((low - high) * (close^5)))
    requires:
    - close
    - high
    - low
    - open
    default_sign: 1
  alpha101_055:
    label: Alpha101 第 55 号
    description: 用收盘价、最高价、最低价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (-1 * correlation(rank(((close - ts_min(low, 12)) / (ts_max(high, 12) - ts_min(low, 12)))), rank(volume),
      6))
    requires:
    - close
    - high
    - low
    - volume
    default_sign: 1
  alpha101_056:
    label: Alpha101 第 56 号
    description: 用每天涨跌幅、总市值计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (0 - (1 * (rank((sum(returns, 10) / sum(sum(returns, 2), 3))) * rank((returns * cap)))))
    requires:
    - cap
    - close
    default_sign: 1
  alpha101_057:
    label: Alpha101 第 57 号
    description: 用收盘价、成交均价计算选股分数。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (0 - (1 * ((close - vwap) / decay_linear(rank(ts_argmax(close, 30)), 2))))
    requires:
    - close
    - raw_close
    - vwap
    default_sign: 1
  alpha101_058:
    label: Alpha101 第 58 号
    description: 用成交量、成交均价计算选股分数。还需要当时的行业分类。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (-1 * Ts_Rank(decay_linear(correlation(IndNeutralize(vwap, IndClass.sector), volume, 3.92795), 7.89291),
      5.50322))
    requires:
    - industry_history
    - raw_close
    - volume
    - vwap
    default_sign: 1
  alpha101_059:
    label: Alpha101 第 59 号
    description: 用成交量、成交均价计算选股分数。还需要当时的行业分类。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (-1 * Ts_Rank(decay_linear(correlation(IndNeutralize(((vwap * 0.728317) + (vwap * (1 - 0.728317))),
      IndClass.industry), volume, 4.25197), 16.2289), 8.19648))
    requires:
    - industry_history
    - raw_close
    - volume
    - vwap
    default_sign: 1
  alpha101_060:
    label: Alpha101 第 60 号：结合收盘位置、成交量和近期高点
    description: 用收盘价、最高价、最低价、成交量计算选股分数。
    category: Alpha101
    kind: alpha101
    formula: (0 - (1 * ((2 * scale(rank(((((close - low) - (high - close)) / (high - low)) * volume)))) - scale(rank(ts_argmax(close,
      10))))))
    requires:
    - close
    - high
    - low
    - volume
    default_sign: 1
  alpha101_061:
    label: Alpha101 第 61 号
    description: 用成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (rank((vwap - ts_min(vwap, 16.1219))) < rank(correlation(vwap, adv180, 17.9282)))
    requires:
    - amount
    - raw_close
    - vwap
    default_sign: 1
  alpha101_062:
    label: Alpha101 第 62 号
    description: 用开盘价、最高价、最低价、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: ((rank(correlation(vwap, sum(adv20, 22.4101), 9.91009)) < rank(((rank(open) + rank(open)) < (rank(((high
      + low) / 2)) + rank(high))))) * -1)
    requires:
    - amount
    - high
    - low
    - open
    - raw_close
    - vwap
    default_sign: 1
  alpha101_063:
    label: Alpha101 第 63 号
    description: 用开盘价、收盘价、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。还需要当时的行业分类。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: ((rank(decay_linear(delta(IndNeutralize(close, IndClass.industry), 2.25164), 8.22237)) - rank(decay_linear(correlation(((vwap
      * 0.318108) + (open * (1 - 0.318108))), sum(adv180, 37.2467), 13.557), 12.2883))) * -1)
    requires:
    - amount
    - close
    - industry_history
    - open
    - raw_close
    - vwap
    default_sign: 1
  alpha101_064:
    label: Alpha101 第 64 号
    description: 用开盘价、最高价、最低价、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: ((rank(correlation(sum(((open * 0.178404) + (low * (1 - 0.178404))), 12.7054), sum(adv120, 12.7054),
      16.6208)) < rank(delta(((((high + low) / 2) * 0.178404) + (vwap * (1 - 0.178404))), 3.69741))) * -1)
    requires:
    - amount
    - high
    - low
    - open
    - raw_close
    - vwap
    default_sign: 1
  alpha101_065:
    label: Alpha101 第 65 号
    description: 用开盘价、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: ((rank(correlation(((open * 0.00817205) + (vwap * (1 - 0.00817205))), sum(adv60, 8.6911), 6.40374))
      < rank((open - ts_min(open, 13.635)))) * -1)
    requires:
    - amount
    - open
    - raw_close
    - vwap
    default_sign: 1
  alpha101_066:
    label: Alpha101 第 66 号
    description: 用开盘价、最高价、最低价、成交均价计算选股分数。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: ((rank(decay_linear(delta(vwap, 3.51013), 7.23052)) + Ts_Rank(decay_linear(((((low * 0.96633) + (low
      * (1 - 0.96633))) - vwap) / (open - ((high + low) / 2))), 11.4157), 6.72611)) * -1)
    requires:
    - high
    - low
    - open
    - raw_close
    - vwap
    default_sign: 1
  alpha101_067:
    label: Alpha101 第 67 号
    description: 用最高价、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。还需要当时的行业分类。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: ((rank((high - ts_min(high, 2.14593)))^rank(correlation(IndNeutralize(vwap, IndClass.sector), IndNeutralize(adv20,
      IndClass.subindustry), 6.02936))) * -1)
    requires:
    - amount
    - high
    - industry_history
    - raw_close
    - vwap
    default_sign: 1
  alpha101_068:
    label: Alpha101 第 68 号
    description: 用收盘价、最高价、最低价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。
    category: Alpha101
    kind: alpha101
    formula: ((Ts_Rank(correlation(rank(high), rank(adv15), 8.91644), 13.9333) < rank(delta(((close * 0.518371)
      + (low * (1 - 0.518371))), 1.06157))) * -1)
    requires:
    - amount
    - close
    - high
    - low
    default_sign: 1
  alpha101_069:
    label: Alpha101 第 69 号
    description: 用收盘价、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。还需要当时的行业分类。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: ((rank(ts_max(delta(IndNeutralize(vwap, IndClass.industry), 2.72412), 4.79344))^Ts_Rank(correlation(((close
      * 0.490655) + (vwap * (1 - 0.490655))), adv20, 4.92416), 9.0615)) * -1)
    requires:
    - amount
    - close
    - industry_history
    - raw_close
    - vwap
    default_sign: 1
  alpha101_070:
    label: Alpha101 第 70 号
    description: 用收盘价、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。还需要当时的行业分类。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: ((rank(delta(vwap, 1.29456))^Ts_Rank(correlation(IndNeutralize(close, IndClass.industry), adv50, 17.8256),
      17.9171)) * -1)
    requires:
    - amount
    - close
    - industry_history
    - raw_close
    - vwap
    default_sign: 1
  alpha101_071:
    label: Alpha101 第 71 号
    description: 用开盘价、收盘价、最低价、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: max(Ts_Rank(decay_linear(correlation(Ts_Rank(close, 3.43976), Ts_Rank(adv180, 12.0647), 18.0175), 4.20501),
      15.6948), Ts_Rank(decay_linear((rank(((low + open) - (vwap + vwap)))^2), 16.4662), 4.4388))
    requires:
    - amount
    - close
    - low
    - open
    - raw_close
    - vwap
    default_sign: 1
  alpha101_072:
    label: Alpha101 第 72 号
    description: 用最高价、最低价、成交量、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (rank(decay_linear(correlation(((high + low) / 2), adv40, 8.93345), 10.1519)) / rank(decay_linear(correlation(Ts_Rank(vwap,
      3.72469), Ts_Rank(volume, 18.5188), 6.86671), 2.95011)))
    requires:
    - amount
    - high
    - low
    - raw_close
    - volume
    - vwap
    default_sign: 1
  alpha101_073:
    label: Alpha101 第 73 号
    description: 用开盘价、最低价、成交均价计算选股分数。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (max(rank(decay_linear(delta(vwap, 4.72775), 2.91864)), Ts_Rank(decay_linear(((delta(((open * 0.147155)
      + (low * (1 - 0.147155))), 2.03608) / ((open * 0.147155) + (low * (1 - 0.147155)))) * -1), 3.33829), 16.7411))
      * -1)
    requires:
    - low
    - open
    - raw_close
    - vwap
    default_sign: 1
  alpha101_074:
    label: Alpha101 第 74 号
    description: 用收盘价、最高价、成交量、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: ((rank(correlation(close, sum(adv30, 37.4843), 15.1365)) < rank(correlation(rank(((high * 0.0261661)
      + (vwap * (1 - 0.0261661)))), rank(volume), 11.4791))) * -1)
    requires:
    - amount
    - close
    - high
    - raw_close
    - volume
    - vwap
    default_sign: 1
  alpha101_075:
    label: Alpha101 第 75 号
    description: 用最低价、成交量、成交均价计算选股分数。还需要成交额，用于计算过去一段时间的平均成交额。成交均价必须与复权价格保持一致，缺少原始价格时不能计算。
    category: Alpha101
    kind: alpha101
    formula: (rank(correlation(vwap, volume, 4.24304)) < rank(correlation(rank(low), rank(adv50), 12.4413)))
