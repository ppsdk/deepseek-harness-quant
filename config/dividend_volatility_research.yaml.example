base_config: dividend_timing_research
output_dir: output/strategy_research/dividend_volatility_v1
cashflow_output_dir: output/strategy_research/dividend_volatility_cashflow_v1
overlay_output_dir: output/strategy_research/dividend_overlay_v1
windows: [20, 60]
target_volatilities: [0.08, 0.10, 0.12]
annual_days: 242
floors: {stock: 0.30, etf: 0.0}
rebalance_days: 10
min_trade_interval_days: 10
rebalance_threshold_pct: 5
selection: discovery_median_calmar
design_note: 在已观察到慢均线择时失败后提出的探索性波动预算检验，重新仅按2020-2022发现期选参。验证期已被本轮早先均线研究观察，不称盲测。按前收盘已知波动率计算仓位，下一开盘按现金账本调仓。静态匹配仓位对照的平均仓位来自完整区间，仅事后解释风险收益，不可作为实盘可用参数。
overlay:
  benchmark_code: 000300.SH
  market_fast: 20
  market_slow: 60
  market_confirm_days: 2
  market_caps: {stock: 0.50, etf: 0.50}
  bollinger_period: 20
  bollinger_k: 2.0
  bollinger_overbought_position: 0.95
  bollinger_cap: 0.80
  kdj_period: 9
  kdj_smooth: 3
  kdj_overbought: 80
  kdj_cap: 0.80
  variants: [base, market_gate, bollinger, kdj, combo]
overlay_base:
  stock: {window: 60, target_volatility: 0.12}
  etf: {window: 20, target_volatility: 0.12}
reversal:
  output_dir: output/strategy_research/dividend_reversal_v1
  signal_basis: causal_total_return_ohlc
  variants: [kdj, bollinger, combo]
  kdj_period: 9
  kdj_smooth: 3
  oversold: 30
  overbought: 70
  bollinger_period: 20
  bollinger_k: 2.0
  low_position: 0.10
  high_position: 0.90
  setup_lookback: 5
  confirmation_lookback: 3
  trend_period: 10
  trend_confirm: 2
  min_trade_interval_days: 1
  design_note: 低位出现后等待金叉或收复下轨，持有至高位转弱或上涨后跌破短均线。仅使用当时已发生公司行为构造连续信号；未复权价格成交并单独计分红税费。固定三组候选按发现期比较，其他历史已被查看，不是盲测；不保证买到最低或卖到最高。
kdj_parameter:
  output_dir: output/strategy_research/dividend_kdj_parameter_v1
  base_settings:
    bollinger_period: 20
    bollinger_k: 2.0
    low_position: 0.10
    high_position: 0.90
    setup_lookback: 5
    confirmation_lookback: 3
    trend_period: 10
    trend_confirm: 2
    min_trade_interval_days: 1
  kdj_grid:
    - {period: 5, smooth: 3, oversold: 20, overbought: 80}
    - {period: 9, smooth: 3, oversold: 30, overbought: 70}
    - {period: 14, smooth: 3, oversold: 30, overbought: 70}
    - {period: 14, smooth: 5, oversold: 20, overbought: 80}
  filtered_grid:
    - {trend_slow_period: 60, volume_min_ratio: 0.8, stop_loss_pct: 0, trailing_stop_pct: 0}
    - {trend_slow_period: 60, volume_min_ratio: 1.0, stop_loss_pct: 0, trailing_stop_pct: 0}
    - {trend_slow_period: 120, volume_min_ratio: 0.8, stop_loss_pct: 0, trailing_stop_pct: 0}
    - {trend_slow_period: 60, volume_min_ratio: 0.8, stop_loss_pct: 8, trailing_stop_pct: 0}
    - {trend_slow_period: 60, volume_min_ratio: 0.8, stop_loss_pct: 0, trailing_stop_pct: 10}
    - {trend_slow_period: 60, volume_min_ratio: 1.0, stop_loss_pct: 8, trailing_stop_pct: 10}
  trend_fast_period: 20
  trend_slope_lookback: 5
  trend_max_below_slow: 0.02
  volume_period: 20
  volume_confirm_lookback: 3
  trend_enabled: true
  volume_enabled: true
  exit_period: 10
  exit_confirm: 2
  risk_cooldown_days: 5
